[run]
branch = True
# Count the isolated corpus tool replay as well as its controlling pytest process.
# https://pytest-cov.readthedocs.io/en/stable/subprocess-support.html
patch = subprocess
source = venom_core
omit = tests/*
    venom_core/agents/writer.py
    venom_core/infrastructure/onnx_runtime.py
    venom_core/perception/antenna.py

[report]
exclude_lines =
    if __name__ == "__main__":
    pragma: no cover
    if TYPE_CHECKING:
    if settings\.DEBUG
    if SETTINGS\.DEBUG
    logger\.
    logging\.
    raise NotImplementedError
    except ImportError
    @abstractmethod
    class.*\(.*Protocol.*\):
    class.*\(.*ABC.*\):
