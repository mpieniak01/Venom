      "lock": "requirements/locks/full-linux-py314.txt",
      "boundary": "Application features include in-process DA2/RAG Torch and CPU ONNX voice/floor consumers. CUDA multi_runtime daemon uses its own component interpreter; Ollama stays an external HTTP service. No GPU ONNX or vLLM in this environment."
    },
    "full-ci": {
      "kind": "application",
      "extends": "full",
      "groups": [
        "ci"
      ],
      "input": "requirements-full-ci.txt",
      "lock": "requirements/locks/full-ci-linux-py314.txt",
      "boundary": "Full application plus the same CI tools; no training, GPU ONNX or vLLM component installation."
    },
    "multi-runtime-cuda": {
      "kind": "component",
      "groups": [
        "multi-runtime-base",
        "model-runtime",
        "audio-runtime",
        "ocr"
